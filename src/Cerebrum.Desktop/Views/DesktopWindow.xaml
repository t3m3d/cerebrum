<Window x:Class="Cerebrum.Desktop.Views.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerebrum Desktop"
        Width="1280"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="#0B0E18"
        Foreground="#F5F7FF"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#D91A1E29" />
        <SolidColorBrush x:Key="ElevatedBrush" Color="#E5262C3C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7C8CFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA5BD" />

        <Style x:Key="DesktopAction" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#B3262C3C" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E03A435A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A07C8CFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.14" GradientOrigin="0.18,0.14" RadiusX="0.9" RadiusY="1.1">
                <GradientStop Color="#FF2C285C" Offset="0" />
                <GradientStop Color="#FF11172C" Offset="0.42" />
                <GradientStop Color="#FF080B14" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Image Source="{Binding WallpaperPath}"
               Stretch="UniformToFill"
               Opacity="0.48"
               IsHitTestVisible="False" />

        <Ellipse Width="620"
                 Height="620"
                 Margin="-280,-340,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Fill="#247C8CFF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="80" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="48,40,48,100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" Background="{StaticResource AccentBrush}" CornerRadius="14" Margin="0,0,14,0">
                    <TextBlock Text="C" FontSize="24" FontWeight="Bold" Foreground="#0B0E18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="CEREBRUM" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="DESKTOP SESSION" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ClockText}" FontSize="30" FontWeight="Light" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Right" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Width="330" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Your workspace, awake."
                           FontSize="34"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="Cerebrum coordinates independent desktop components while Windows continues to provide composition, input, and security."
                           Foreground="#C8D1E4"
                           FontSize="14"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,0,0,28" />

                <Button Style="{StaticResource DesktopAction}" Command="{Binding OpenFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣" FontSize="22" Width="38" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Open Cortex" FontWeight="SemiBold" />
                            <TextBlock Text="Files, search, archives, and operations" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DesktopAction}" Command="{Binding ShowOverviewCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌘" FontSize="22" Width="38" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Show Thalamus Overview" FontWeight="SemiBold" />
                            <TextBlock Text="Windows, layouts, monitors, and tiling" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DesktopAction}" Command="{Binding CaptureRegionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="?" FontSize="22" Width="38" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Capture with Snip" FontWeight="SemiBold" />
                            <TextBlock Text="Select a region, annotate, copy, or save" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DesktopAction}" Command="{Binding EnsureTaskbarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▬" FontSize="22" Width="38" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Ensure Medulla Is Running" FontWeight="SemiBold" />
                            <TextBlock Text="Taskbar, launcher, pins, and clock" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22"
                    VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <Border DockPanel.Dock="Right" Background="#287C8CFF" CornerRadius="8" Padding="9,4">
                            <TextBlock Text="{Binding DisplayBadge}" Foreground="#C7CFFF" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="SESSION HEALTH" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBlock Text="{Binding MonitorName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding IndicatorBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#2CFFFFFF" Margin="0,4,0,16" />
                    <TextBlock Text="{Binding SessionSummary}" Foreground="#D5DCF0" FontSize="12" Margin="0,0,0,14" />
                    <Button Style="{StaticResource DesktopAction}" Command="{Binding RepairSessionCommand}" Margin="0,0,0,8">
                        <TextBlock Text="Repair missing session components" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource DesktopAction}" Command="{Binding ExitCommand}" Margin="0">
                        <TextBlock Text="Exit Cerebrum desktop" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,8,0" />
                <TextBlock Text="COMPATIBILITY MODE · EXPLORER REMAINS AVAILABLE FOR RECOVERY"
                           Foreground="#91A0BC"
                           FontSize="10" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
